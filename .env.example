# Optional: the complete demo and evidence retrieval work without a model.
OPENAI_API_KEY=
FINN_MODEL=gpt-4.1-mini
# Private hosting uses a token. Public synthetic demos may explicitly opt out below.
FINN_ACCESS_TOKEN=
# Only for a publicly shared demo with synthetic people; disables model calls.
FINN_PUBLIC_DEMO=false
# Include the hostname/IP used in your browser when allowing phone access.
FINN_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
# Live background refresh is opt-in; foreground live mode also refreshes on demand.
FINN_BACKGROUND_LIVE=false
FINN_POLL_SECONDS=900
